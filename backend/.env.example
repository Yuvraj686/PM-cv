# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:6543/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
SECRET_KEY=change-me-to-a-256-bit-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic Claude API
ANTHROPIC_API_KEY=

# OpenAI API (task generator, risk analysis, writing assist)
OPENAI_API_KEY=
AI_DAILY_LIMIT=10

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Email API
EMAIL_API_KEY=
FROM_EMAIL=noreply@projecthub.app

# App Config
FRONTEND_URL=http://localhost:3000
APP_NAME=ProjectHub
ENV=development
ALLOWED_ORIGINS=
SENTRY_DSN=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
