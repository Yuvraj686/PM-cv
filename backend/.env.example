# ==========================================
# ProjectHub Production Environment Template
# ==========================================
# Copy this file to '.env' and populate the actual secrets/keys.
# NEVER commit the active '.env' file containing real secrets to version control.

# ------------------------------------------
# 1. Database (Supabase PostgreSQL)
# ------------------------------------------
# The PostgreSQL connection string. Use port 6543 (connection pooling) for production/serverless environments.
# Format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.xxxx.supabase.co:6543/postgres

# ------------------------------------------
# 2. Redis Cache & Messaging Broker
# ------------------------------------------
# Redis server connection URI. Used for Celery backend, presence channels, and real-time presence caching.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# 3. Security & JWT Session Signing
# ------------------------------------------
# A secure 256-bit key used to sign access/refresh tokens. Generate using: `openssl rand -base64 32`
SECRET_KEY=change-me-to-a-secure-256-bit-secret-key

# JWT Token Signing Algorithm
ALGORITHM=HS256

# JWT Access token lifespan in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15

# JWT Refresh token lifespan in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet-compatible key used for encrypting database integration credentials. Generate with: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=your-fernet-compatible-encryption-key-here

# ------------------------------------------
# 4. Artificial Intelligence (AI Models)
# ------------------------------------------
# Anthropic Claude API Key (optional fallback). Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key (required for task generation, risk reports, writing assistant). Get from: https://platform.openai.com/
OPENAI_API_KEY=

# Daily AI request limit per user to manage API expenses
AI_DAILY_LIMIT=10

# ------------------------------------------
# 5. Third-Party Integrations & OAuth
# ------------------------------------------
# --- GitHub Integration ---
# GitHub Repository Webhook Secret for real-time repository sync.
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# GitHub Personal Access Token (PAT) to perform commits/PR sync.
GITHUB_TOKEN=your-github-token

# --- GitHub OAuth Login ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Google OAuth Login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Slack Integration ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback

# ------------------------------------------
# 6. Email Delivery API
# ------------------------------------------
# Resend or SMTP provider API Key for verification and password reset emails. Get from: https://resend.com/
EMAIL_API_KEY=
# Sender email address displayed to users
FROM_EMAIL=noreply@projecthub.app

# ------------------------------------------
# 7. Global Application Configuration
# ------------------------------------------
# Base URL of the React/Next.js frontend application (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Name of the application displayed in templates and emails
APP_NAME=ProjectHub

# Deployment environment type ('development', 'staging', 'production')
ENV=development

# Comma-separated list of origins permitted to make CORS requests in production (e.g., https://app.projecthub.com)
ALLOWED_ORIGINS=

# Sentry DSN for client/server error tracking. Get from: https://sentry.io/
SENTRY_DSN=
